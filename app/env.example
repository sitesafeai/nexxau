# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/nexxau_db"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Authentication Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration (for notifications)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Cloudinary Configuration (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Detection Service
YOLO_STREAM_URL="http://localhost:5001/video_feed"
AI_DETECTION_API_KEY="your-ai-api-key"
AI_DETECTION_ENDPOINT="https://api.your-ai-service.com/detect"

# Camera Integration
CAMERA_API_ENDPOINT="https://api.your-camera-service.com"
CAMERA_API_KEY="your-camera-api-key"
RTSP_STREAM_URL="rtsp://username:password@camera-ip:554/stream"

# Janus Gateway Configuration (REQUIRED for WebRTC streaming)
# Full WebSocket URL to Janus Gateway
NEXT_PUBLIC_JANUS_SERVER_URL="ws://localhost:8088/janus"
# Janus HTTP API URL (required for RTP forwarding control)
JANUS_HTTP_URL="http://localhost:8088/janus"
# Janus Admin API URL (required for RTSP mount management)
JANUS_ADMIN_URL="http://localhost:7088/admin"
# Janus RTP ingest (ffmpeg push)
JANUS_RTP_HOST="127.0.0.1"
JANUS_RTP_BASE_PORT="20000"
JANUS_RTP_PORT_RANGE="10000"
JANUS_RTP_CODEC="h264"
JANUS_RTP_PAYLOAD_TYPE="96"
# Camera ingest worker (must not use 3000 - that's Next.js)
CAMERA_INGEST_SERVICE_URL="http://localhost:3001"
CAMERA_INGEST_TIMEOUT_MS="10000"
# Optional admin secret
# JANUS_ADMIN_SECRET="change-me"

# YOLO (Janus RTP-fed)
YOLO_SERVICE_URL="http://localhost:8765"
YOLO_RTP_HOST="127.0.0.1"
YOLO_RTP_BASE_PORT="5004"
YOLO_RTP_CODEC="vp8"
NEXT_PUBLIC_YOLO_WS_URL="ws://localhost:8766/ws/detections"

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USE_MOCK_DATA="false"
NEXT_PUBLIC_ENVIRONMENT="development"

# Security
JWT_SECRET="your-jwt-secret-here"
ENCRYPTION_KEY="your-encryption-key-here"
SESSION_SECRET="your-session-secret-here"
CSRF_SECRET="your-csrf-secret-here"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Monitoring & Analytics
SENTRY_DSN="your-sentry-dsn"
ANALYTICS_ID="your-analytics-id"
LOG_LEVEL="info"

# Production Settings
NODE_ENV="development"
NEXT_PUBLIC_ENVIRONMENT="development"

# Backup & Recovery
BACKUP_ENABLED="false"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Performance
CACHE_TTL=3600
MAX_FILE_SIZE=10485760 