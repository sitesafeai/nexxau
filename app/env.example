# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/nexxau_db"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Authentication Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration (for notifications)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Cloudinary Configuration (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Detection Service
YOLO_STREAM_URL="http://localhost:5001/video_feed"
AI_DETECTION_API_KEY="your-ai-api-key"
AI_DETECTION_ENDPOINT="https://api.your-ai-service.com/detect"

# Camera Integration
CAMERA_API_ENDPOINT="https://api.your-camera-service.com"
CAMERA_API_KEY="your-camera-api-key"
RTSP_STREAM_URL="rtsp://username:password@camera-ip:554/stream"

# Janus Gateway Configuration (REQUIRED for WebRTC streaming)
# Full WebSocket URL to Janus Gateway (e.g., wss://janus.example.com/janus)
JANUS_SERVER_URL="wss://janus.example.com/janus"
# For local development, if Janus runs on localhost:
# JANUS_SERVER_URL="ws://localhost:8088/janus"

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USE_MOCK_DATA="false"
NEXT_PUBLIC_ENVIRONMENT="development"

# Security
JWT_SECRET="your-jwt-secret-here"
ENCRYPTION_KEY="your-encryption-key-here"
SESSION_SECRET="your-session-secret-here"
CSRF_SECRET="your-csrf-secret-here"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Monitoring & Analytics
SENTRY_DSN="your-sentry-dsn"
ANALYTICS_ID="your-analytics-id"
LOG_LEVEL="info"

# Production Settings
NODE_ENV="development"
NEXT_PUBLIC_ENVIRONMENT="development"

# Backup & Recovery
BACKUP_ENABLED="false"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Performance
CACHE_TTL=3600
MAX_FILE_SIZE=10485760 