# ============================================================================
# Streaming Configuration (go2rtc + YOLO Detection)
# ============================================================================

# go2rtc streaming gateway
GO2RTC_URL=http://localhost:1984
NEXT_PUBLIC_GO2RTC_URL=http://localhost:1984
GO2RTC_RESTREAM_RTSP=rtsp://localhost:8554

# MediaMTX credentials - must match authInternalUsers in mediamtx.yml
MEDIAMTX_USER=
MEDIAMTX_PASS=

# YOLO detection service
YOLO_SERVICE_URL=http://localhost:5001
DETECTION_FPS=3.0

# Shared secret used by internal services (YOLO, snapshot) to call authenticated API endpoints.
# Must be a long random string (min 32 chars). Generate with: openssl rand -hex 32
# Set the SAME value in: app/.env, backend/.env, services/yolo-detection-service/.env,
# and your production secret store (k8s secret / Railway variable / etc).
INTERNAL_SERVICE_TOKEN=

# ============================================================================
# Database Configuration
# ============================================================================
# Supabase: use connection pooler (port 6543) to avoid exhaustion.
# Dashboard → Project Settings → Database → Connection Pooling (Transaction mode) and Connection string.
# For local Postgres, set both to the same URL (e.g. postgresql://user:pass@localhost:5432/nexxau_db).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=5"
DIRECT_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Authentication Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email — all app email uses Resend (https://resend.com)
RESEND_API_KEY="re_..."
# Verified sender, e.g. Nexxau <contact@yourdomain.com> (must match a domain verified in Resend)
RESEND_FROM="Nexxau <contact@yourdomain.com>"
# Optional: detection-alert emails (defaults to RESEND_FROM)
# ALERT_FROM_EMAIL="Nexxau <alerts@yourdomain.com>"
# Optional: GET /api/test-email and scripts/test-email.js recipient
# TEST_EMAIL_TO="you@example.com"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Cloudinary Configuration (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================================================
# LEGACY - Janus Gateway (TO BE REMOVED after go2rtc migration)
# ============================================================================
# These are kept for backward compatibility during migration
NEXT_PUBLIC_JANUS_SERVER_URL="ws://localhost:8088/janus"
JANUS_HTTP_URL="http://localhost:8088/janus"
JANUS_ADMIN_URL="http://localhost:7088/admin"
JANUS_RTP_HOST="127.0.0.1"
JANUS_RTP_BASE_PORT="20000"
JANUS_RTP_PORT_RANGE="10000"

# Camera Integration
CAMERA_API_ENDPOINT="https://api.your-camera-service.com"
CAMERA_API_KEY="your-camera-api-key"
RTSP_STREAM_URL="rtsp://username:password@camera-ip:554/stream"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Application Settings
NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"

# Comma-separated list of allowed CORS origins for the FastAPI backend.
# Example: http://localhost:3000,https://app.nexxau.com
BACKEND_CORS_ORIGINS=http://localhost:3000

# Comma-separated list of origins that may call /api/* routes from browsers.
# The middleware echoes back the matched origin — never reflects '*'.
# Dev default (localhost:3000) is used when this var is unset.
ALLOWED_API_ORIGINS=https://nexxau.com,https://www.nexxau.com,http://localhost:3000
