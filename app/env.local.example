# Database Configuration
DATABASE_URL="file:../prisma/dev.db"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Authentication Providers (optional for now)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration (for notifications) - optional for now
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER="your-email@gmail.com"
# EMAIL_SERVER_PASSWORD="your-app-password"

# Cloudinary Configuration (for image uploads) - optional for now
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# AI Detection Service
YOLO_STREAM_URL="http://localhost:5001/video_feed"

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USE_MOCK_DATA="true"

# Security
JWT_SECRET="your-jwt-secret-here-change-in-production"
ENCRYPTION_KEY="your-encryption-key-here-change-in-production"

# MediaMTX Configuration (REQUIRED for camera registration)
# MEDIAMTX_API_URL is required
# MEDIAMTX_API_USERNAME and MEDIAMTX_API_PASSWORD are optional for local/dev
# If not provided, API calls will be unauthenticated (for local development)
MEDIAMTX_API_URL="http://localhost:9000"
# MEDIAMTX_API_USERNAME="admin"  # Optional - only needed if MediaMTX requires auth
# MEDIAMTX_API_PASSWORD="admin"  # Optional - only needed if MediaMTX requires auth

# Production Settings
NODE_ENV="development"
NEXT_PUBLIC_ENVIRONMENT="development" 