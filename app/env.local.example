# Database Configuration (Supabase example)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres.xxx@aws-0-xxx.pooler.supabase.com:5432/postgres?sslmode=no-verify"
#
# If "Authentication failed" persists: Supabase free projects pause after inactivity.
# Restore from dashboard, then copy fresh connection string from Settings -> Database.

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Authentication Providers (optional for now)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (Resend) — optional for local unless testing mail
# RESEND_API_KEY="re_..."
# RESEND_FROM="Nexxau <contact@yourdomain.com>"

# Cloudinary Configuration (for image uploads) - optional for now
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# AI Detection Service
YOLO_STREAM_URL="http://localhost:5001/video_feed"

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USE_MOCK_DATA="true"

# Security
JWT_SECRET="your-jwt-secret-here-change-in-production"
ENCRYPTION_KEY="your-encryption-key-here-change-in-production"

# MediaMTX Configuration (REQUIRED for camera registration)
# MEDIAMTX_API_URL is required
# MEDIAMTX_API_USERNAME and MEDIAMTX_API_PASSWORD are optional for local/dev
# If not provided, API calls will be unauthenticated (for local development)
MEDIAMTX_API_URL="http://localhost:9000"
# MEDIAMTX_API_USERNAME="admin"  # Optional - only needed if MediaMTX requires auth
# MEDIAMTX_API_PASSWORD="admin"  # Optional - only needed if MediaMTX requires auth

# Camera ingest worker (port 3001 to avoid conflict with Next.js on 3000)
CAMERA_INGEST_SERVICE_URL="http://localhost:3001"
CAMERA_INGEST_TIMEOUT_MS="10000"

# Janus Gateway Configuration (REQUIRED for WebRTC streaming)
# Full WebSocket URL to Janus Gateway
NEXT_PUBLIC_JANUS_SERVER_URL="ws://localhost:8088/janus"
# Janus HTTP API URL (required for RTP forwarding control)
JANUS_HTTP_URL="http://localhost:8088/janus"
# Janus Admin API URL (required for RTSP mount management)
JANUS_ADMIN_URL="http://localhost:7088/admin"
# JANUS_RTP_HOST: Where ingest service pushes RTP. Use VM IP (e.g. 192.168.64.4) if Janus is remote.
# Default 127.0.0.1 only works when Janus runs on same host as the app.
# JANUS_RTP_HOST="192.168.64.4"
# Optional admin secret
# JANUS_ADMIN_SECRET="change-me"

# YOLO (Janus RTP-fed)
YOLO_SERVICE_URL="http://localhost:8765"
YOLO_RTP_HOST="127.0.0.1"
YOLO_RTP_BASE_PORT="5004"
YOLO_RTP_CODEC="vp8"
NEXT_PUBLIC_YOLO_WS_URL="ws://localhost:8766/ws/detections"

# Production Settings
NODE_ENV="development"
NEXT_PUBLIC_ENVIRONMENT="development" 