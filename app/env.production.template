# Production Environment Configuration Template
# Copy this to .env.production and update with your actual values

NODE_ENV=production

# Database Configuration with Connection Pooling
DATABASE_URL="postgresql://username:password@localhost:5432/nexxau_production?connection_limit=20&pool_timeout=20&connect_timeout=20"
DIRECT_URL="postgresql://username:password@localhost:5432/nexxau_production"

# Redis Configuration (for session storage and caching)
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secure-jwt-secret-key-here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# NextAuth Configuration
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# AI Detection Service
AI_DETECTION_URL="http://localhost:8000"
AI_DETECTION_API_KEY="your-ai-api-key"

# MediaMTX Configuration
MEDIAMTX_URL="http://localhost:8888"
MEDIAMTX_API_KEY="your-mediamtx-api-key"

# Janus Gateway Configuration
NEXT_PUBLIC_JANUS_SERVER_URL="wss://your-janus-domain.com/janus"
JANUS_HTTP_URL="http://localhost:8088/janus"
JANUS_ADMIN_URL="http://localhost:7088/admin"
JANUS_RTP_HOST="127.0.0.1"
JANUS_RTP_BASE_PORT="20000"
JANUS_RTP_PORT_RANGE="10000"
JANUS_RTP_CODEC="h264"
JANUS_RTP_PAYLOAD_TYPE="96"

# Camera ingest worker
CAMERA_INGEST_SERVICE_URL="http://localhost:3001"
CAMERA_INGEST_TIMEOUT_MS="10000"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@your-domain.com"

# Monitoring and Logging
LOG_LEVEL="info"
SENTRY_DSN="your-sentry-dsn-here"

# Security
CORS_ORIGIN="https://your-domain.com"
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="/uploads"

# Performance
CACHE_TTL=3600
ENABLE_COMPRESSION=true
ENABLE_CACHING=true