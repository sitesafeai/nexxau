generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  location     String?
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String                  @id @default(cuid())
  name               String?
  email              String?                 @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  phoneNumber        String?
  role               UserRole                @default(WORKER)
  companyId          String?
  worksiteId         String?
  inviteToken        String?                 @unique
  inviteExpires      DateTime?
  invitedBy          String?
  isActivated        Boolean                 @default(false)
  approved           Boolean                 @default(false)
  onboardingComplete Boolean                 @default(false)
  verificationToken  String?                 @unique
  mfaEnabled         Boolean                 @default(false)
  mfaSecret          String?
  mfaBackupCodes     Json?
  lastLogin          DateTime?
  timezone           String?                 @default("America/New_York")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  accounts           Account[]
  sessions           Session[]
  company            Company?                @relation(fields: [companyId], references: [id])
  worksite           Worksite?               @relation(fields: [worksiteId], references: [id])
  worksiteAccess     WorksiteUser[]
  companyAccess      CompanyUser[]
  alertResponses     AlertResponse[]
  alertRules         AlertRule[]
  resolvedAlerts     Alert[]                 @relation("ResolvedAlerts")
  overriddenAlerts   Alert[]                 @relation("OverriddenAlerts")
  resolutionLogs     AlertResolutionLog[]
  overrideAudits     AlertOverrideAuditLog[]
  blogPosts          BlogPost[]
  mfaCodes           MFACode[]
  apiKeys            ApiKey[]
  activities         UserActivity[]
  notifications      Notification[]
  errorLogs          ErrorLog[]
  customRules        CustomRule[]
  auditLogs          AuditLog[]
  reports            Report[]
  Workflow           Workflow[]
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  entityName String?
  worksiteId String?
  companyId  String?
  changes    Json?
  details    Json?
  result     String?
  severity   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  worksite   Worksite? @relation(fields: [worksiteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([worksiteId])
  @@index([companyId])
  @@index([createdAt])
  @@index([entity, createdAt])
}

model WorksiteUser {
  id          String       @id @default(cuid())
  userId      String
  worksiteId  String
  role        WorksiteRole @default(WORKER)
  permissions Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  worksite    Worksite     @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@unique([userId, worksiteId])
  @@index([userId])
  @@index([worksiteId])
}

model CompanyUser {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id              String                 @id @default(cuid())
  name            String
  companyUsername String                 @unique
  email           String                 @unique
  contactEmail    String?
  phone           String?
  address         String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  worksites       Worksite[]
  users           User[]
  companyUsers    CompanyUser[]
  billingRecords  CompanyBillingRecord[]
}

model Worksite {
  id                       String                    @id @default(cuid())
  name                     String
  worksiteName             String                    @unique
  location                 String?
  address                  String?
  companyId                String
  cameraSystemType         String                    @default("mixed")
  status                   String                    @default("ACTIVE")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  company                  Company                   @relation(fields: [companyId], references: [id])
  cameraSystemConfig       CameraSystemConfig?
  workers                  Worker[]
  users                    User[]
  cameras                  Camera[]
  alerts                   Alert[]
  alertRules               AlertRule[]
  safetyViolations         SafetyViolation[]
  smsNotifications         SMSNotification[]
  emergencyContacts        EmergencyContact[]
  safetyRules              SafetyRule[]
  customRules              CustomRule[]
  ruleTriggers             CustomRuleTrigger[]
  ruleViolations           CustomRuleViolation[]
  safetyScores             SafetyScore[]
  safetyScoreConfig        SafetyScoreConfig?
  violationClassifications ViolationClassification[]
  worksiteUsers            WorksiteUser[]
  falsePositiveReports     FalsePositiveReport[]
  truePositiveReports      TruePositiveReport[]
  trainingImages           TrainingImage[]
  auditLogs                AuditLog[]
  workflows                Workflow[]
  escalationChains         EscalationChain[]
  incidentReports          IncidentReport[]
  worksiteMetrics          WorksiteMetrics[]
  alertBatches             AlertBatch[]

  @@index([companyId])
  @@index([status])
}

model CompanyBillingRecord {
  id          String    @id @default(cuid())
  companyId   String
  proofUrl    String?
  paidThrough DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([paidThrough])
  @@index([createdAt])
}

model Worker {
  id         String   @id @default(cuid())
  name       String
  email      String
  role       String   @default("worker")
  worksiteId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isClaimed  Boolean  @default(false)
  worksite   Worksite @relation(fields: [worksiteId], references: [id])

  @@unique([worksiteId, email])
}

model Alert {
  id                  String                  @id @default(cuid())
  title               String
  description         String
  severity            AlertSeverity
  status              AlertStatus             @default(ACTIVE)
  source              String
  location            String?
  metadata            Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionType      String?
  resolutionNotes     String?
  fpReason            String?
  snoozeUntil         DateTime?
  workerId            String?
  violationType       String?
  detectionSnapshot   String?
  detectionVideo      String?
  detectionData       Json?
  overrideStatus      String?
  overrideBy          String?
  overrideAt          DateTime?
  overrideReason      String?
  modelVersion        String?
  isTrainingCandidate Boolean                 @default(false)
  ruleId              String?
  worksiteId          String?
  cameraId            String?
  resolvedByUser      User?                   @relation("ResolvedAlerts", fields: [resolvedBy], references: [id])
  overrideByUser      User?                   @relation("OverriddenAlerts", fields: [overrideBy], references: [id])
  rule                AlertRule?              @relation(fields: [ruleId], references: [id])
  worksite            Worksite?               @relation(fields: [worksiteId], references: [id])
  camera              Camera?                 @relation(fields: [cameraId], references: [id])
  responses           AlertResponse[]
  resolutionLogs      AlertResolutionLog[]
  overrideAudits      AlertOverrideAuditLog[]
  incidents           Incident[]
  escalations         Escalation[]
  incidentReport      IncidentReport?
}

model AlertResolutionLog {
  id            String   @id @default(cuid())
  alertId       String
  userId        String
  status        String
  notes         String?
  fpReason      String?
  workerId      String?
  violationType String?
  duration      Int?
  createdAt     DateTime @default(now())
  alert         Alert    @relation(fields: [alertId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model AlertOverrideAuditLog {
  id                   String   @id @default(cuid())
  alertId              String
  userId               String
  oldStatus            String?
  newStatus            String
  oldTrainingCandidate Boolean?
  newTrainingCandidate Boolean?
  reason               String?
  notes                String?
  createdAt            DateTime @default(now())
  alert                Alert    @relation(fields: [alertId], references: [id])
  user                 User     @relation(fields: [userId], references: [id])

  @@index([alertId])
  @@index([userId])
  @@index([createdAt])
}

model AlertRule {
  id                  String        @id @default(cuid())
  name                String
  description         String?
  category            RuleCategory
  severity            AlertSeverity
  isActive            Boolean       @default(true)
  targetType          TargetType    @default(SITE_WIDE)
  targetZones         String[]
  targetCameras       String[]
  targetWorkerRoles   String[]
  condition           Json
  actions             Json
  escalationEnabled   Boolean       @default(false)
  escalationDelay     Int           @default(300)
  escalationLevels    Json
  webhookUrl          String?
  apiEndpoint         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  worksiteId          String?
  userId              String?
  triggerCount        Int           @default(0)
  lastTriggered       DateTime?
  averageResponseTime Int?
  alerts              Alert[]
  worksite            Worksite?     @relation(fields: [worksiteId], references: [id])
  user                User?         @relation(fields: [userId], references: [id])
}

model AlertResponse {
  id        String   @id @default(cuid())
  alertId   String
  userId    String
  response  String
  notes     String?
  createdAt DateTime @default(now())
  alert     Alert    @relation(fields: [alertId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Camera {
  id                   String                @id @default(cuid())
  name                 String
  type                 String                @default("RTSP")
  status               String                @default("pending")
  streamUrl            String?
  location             String?
  ipAddress            String?
  port                 Int?
  username             String?
  password             String?
  rtspPath             String?
  hlsUrl               String?
  mediamtxPath         String?
  metadata             Json?
  worksiteId           String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  janusFeedId          Int?
  worksite             Worksite              @relation(fields: [worksiteId], references: [id])
  detections           Detection[]
  health               CameraHealth[]
  safetyViolations     SafetyViolation[]
  smsNotifications     SMSNotification[]
  customRules          CustomRule[]
  ruleTriggers         CustomRuleTrigger[]
  ruleViolations       CustomRuleViolation[]
  trainingImages       TrainingImage[]
  alerts               Alert[]
  falsePositiveReports FalsePositiveReport[]
  truePositiveReports  TruePositiveReport[]

  @@index([worksiteId])
  @@index([status])
}

model CameraSystemConfig {
  id         String   @id @default(cuid())
  worksiteId String   @unique
  config     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  worksite   Worksite @relation(fields: [worksiteId], references: [id])
}

model Detection {
  id           String    @id @default(cuid())
  cameraId     String
  timestamp    DateTime
  detections   Json
  frameData    String?
  frameWidth   Int?
  frameHeight  Int?
  metadata     Json?
  userFeedback String?
  feedbackBy   String?
  feedbackAt   DateTime?
  feedbackNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  camera       Camera    @relation(fields: [cameraId], references: [id])

  @@index([userFeedback])
  @@index([feedbackBy])
  @@index([timestamp])
}

model TrainingImage {
  id          String   @id @default(cuid())
  imageUrl    String
  cameraId    String
  worksiteId  String
  category    String?
  labeled     Boolean  @default(false)
  annotations Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  camera      Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  worksite    Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@index([cameraId])
  @@index([worksiteId])
  @@index([category])
  @@index([labeled])
}

model BlogPost {
  id            String    @id @default(uuid())
  title         String
  description   String
  content       String
  category      String
  featured      Boolean   @default(false)
  publishedAt   DateTime?
  status        String    @default("draft")
  authorId      String?
  featuredImage String?
  slug          String    @unique
  tags          String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  author        User?     @relation(fields: [authorId], references: [id])
}

model MFACode {
  id          String    @id @default(cuid())
  userId      String
  code        String
  type        String
  expiresAt   DateTime
  used        Boolean   @default(false)
  usedAt      DateTime?
  phoneNumber String?
  email       String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id            String    @id @default(cuid())
  name          String
  key           String    @unique
  userId        String
  permissions   Json
  rateLimit     Int       @default(1000)
  isActive      Boolean   @default(true)
  lastUsed      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requestCount  Int       @default(0)
  lastRequestAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserActivity {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  location   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  priority  NotificationPriority @default(MEDIUM)
  isRead    Boolean              @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CameraHealth {
  id            String       @id @default(cuid())
  cameraId      String
  status        CameraStatus
  streamQuality Float?
  frameRate     Float?
  resolution    String?
  bitrate       Int?
  latency       Int?
  errors        Json?
  lastCheck     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  camera        Camera       @relation(fields: [cameraId], references: [id], onDelete: Cascade)
}

model ErrorLog {
  id         String    @id @default(cuid())
  message    String
  stack      String?
  severity   String
  category   String
  userId     String?
  endpoint   String?
  method     String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SafetyViolation {
  id            String    @id @default(cuid())
  violationType String
  severity      String
  location      String
  description   String
  worksiteId    String?
  cameraId      String?
  detectedAt    DateTime
  smsSent       Boolean   @default(false)
  smsSentAt     DateTime?
  resolved      Boolean   @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  worksite      Worksite? @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
  camera        Camera?   @relation(fields: [cameraId], references: [id], onDelete: SetNull)
}

model SMSNotification {
  id            String    @id @default(cuid())
  messageId     String    @unique
  phoneNumber   String
  message       String
  violationType String?
  severity      String?
  location      String?
  worksiteId    String?
  cameraId      String?
  status        String
  errorCode     String?
  errorMessage  String?
  retryCount    Int       @default(0)
  lastRetryAt   DateTime?
  sentAt        DateTime  @default(now())
  deliveredAt   DateTime?
  updatedAt     DateTime  @updatedAt
  worksite      Worksite? @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
  camera        Camera?   @relation(fields: [cameraId], references: [id], onDelete: SetNull)
}

model EmergencyContact {
  id          String    @id @default(cuid())
  name        String
  phoneNumber String
  email       String?
  role        String
  worksiteId  String?
  isActive    Boolean   @default(true)
  priority    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  worksite    Worksite? @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
}

model SafetyRule {
  id                  String    @id @default(cuid())
  name                String
  violationType       String
  severity            String
  confidenceThreshold Int       @default(80)
  smsEnabled          Boolean   @default(true)
  smsRecipients       Json
  isActive            Boolean   @default(true)
  worksiteId          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  worksite            Worksite? @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
}

model CustomRule {
  id                  String                @id @default(cuid())
  name                String
  description         String?
  ruleType            String
  category            String
  severity            String
  isActive            Boolean               @default(true)
  priority            Int                   @default(1)
  detectionCriteria   Json
  triggerConditions   Json
  alertSettings       Json
  timeConstraints     Json?
  locationConstraints Json?
  aiModelType         String?
  confidenceThreshold Float                 @default(0.8)
  customModelPath     String?
  smsEnabled          Boolean               @default(true)
  emailEnabled        Boolean               @default(false)
  dashboardEnabled    Boolean               @default(true)
  smsRecipients       Json?
  emailRecipients     Json?
  cooldownMinutes     Int                   @default(15)
  maxAlertsPerHour    Int                   @default(10)
  worksiteId          String?
  cameraId            String?
  createdBy           String?
  triggerCount        Int                   @default(0)
  lastTriggeredAt     DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  worksite            Worksite?             @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
  camera              Camera?               @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  creator             User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  ruleTriggers        CustomRuleTrigger[]
  ruleViolations      CustomRuleViolation[]
}

model CustomRuleTrigger {
  id             String     @id @default(cuid())
  ruleId         String
  triggerType    String
  confidence     Float
  detectionData  Json
  cameraId       String?
  worksiteId     String?
  location       String?
  timestamp      DateTime   @default(now())
  status         String     @default("triggered")
  processedAt    DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  smsSent        Boolean    @default(false)
  emailSent      Boolean    @default(false)
  dashboardAlert Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  rule           CustomRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  camera         Camera?    @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  worksite       Worksite?  @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
}

model CustomRuleViolation {
  id             String     @id @default(cuid())
  ruleId         String
  triggerId      String?
  violationType  String
  severity       String
  description    String
  detectionData  Json
  imageUrl       String?
  videoUrl       String?
  cameraId       String?
  worksiteId     String?
  location       String?
  detectedAt     DateTime   @default(now())
  status         String     @default("active")
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  smsSent        Boolean    @default(false)
  emailSent      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  rule           CustomRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  camera         Camera?    @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  worksite       Worksite?  @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
}

model SafetyScore {
  id                  String   @id @default(cuid())
  worksiteId          String
  date                DateTime @db.Date
  totalDetections     Int      @default(0)
  majorViolations     Int      @default(0)
  minorViolations     Int      @default(0)
  customAlerts        Json?
  baseCompliance      Float
  coverageFactor      Float
  violationPenalty    Float
  majorPenalty        Float    @default(0)
  minorPenalty        Float    @default(0)
  customAlertPenalty  Float    @default(0)
  scalingFactor       Float    @default(1)
  consecutiveSafeDays Int      @default(0)
  safetyBonus         Float    @default(0)
  safetyScore         Float
  grade               String
  calculationVersion  Int      @default(1)
  calculatedAt        DateTime @default(now())
  yesterdayScore      Float?
  weekAvgScore        Float?
  monthAvgScore       Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  worksite            Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@unique([worksiteId, date])
  @@index([worksiteId, date])
  @@index([date])
}

model SafetyScoreConfig {
  id                     String    @id @default(cuid())
  worksiteId             String?   @unique
  isGlobal               Boolean   @default(false)
  alpha                  Float     @default(1.0)
  beta                   Float     @default(0.25)
  gamma                  Float     @default(1.0)
  alertWeightMin         Float     @default(0.1)
  alertWeightMax         Float     @default(2.0)
  defaultAlertWeight     Float     @default(0.5)
  maxPenalty             Float     @default(0.5)
  perTypeAlertCap        Int       @default(50)
  lambda                 Float     @default(0.1)
  timeWindowSeconds      Int       @default(300)
  spatialThresholdMeters Float     @default(10.0)
  safeDayBonusRate       Float     @default(0.01)
  maxBonus               Float     @default(0.10)
  safeDayThreshold       Int       @default(7)
  minDetections          Int       @default(100)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  worksite               Worksite? @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
}

model ViolationClassification {
  id            String    @id @default(cuid())
  violationType String    @unique
  name          String
  description   String?
  severity      String
  defaultWeight Float     @default(1.0)
  worksiteId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  worksite      Worksite? @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@index([worksiteId])
}

model Report {
  id               String         @id @default(cuid())
  name             String
  ownerId          String?
  isTemplate       Boolean        @default(false)
  isSystem         Boolean        @default(false)
  spec             Json
  schedule         String?
  nextRunAt        DateTime?
  lastRunAt        DateTime?
  deliverySettings Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User?          @relation(fields: [ownerId], references: [id])
  exports          ReportExport[]

  @@index([ownerId])
  @@index([isTemplate])
  @@index([isSystem])
}

model ReportExport {
  id            String    @id @default(cuid())
  reportId      String
  jobId         String    @unique
  format        String
  status        String    @default("queued")
  fileKey       String?
  fileUrl       String?
  fileSize      Int?
  error         String?
  requestedBy   String
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?
  downloadCount Int       @default(0)
  report        Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([jobId])
  @@index([status])
}

model Incident {
  id             String    @id @default(cuid())
  title          String
  description    String?
  severity       String
  status         String    @default("open")
  alertId        String?
  cameraId       String?
  worksiteId     String
  ownerId        String?
  assignedTo     String?
  evidence       Json?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionType String?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  alert          Alert?    @relation(fields: [alertId], references: [id])

  @@index([worksiteId])
  @@index([status])
  @@index([alertId])
}

model Workflow {
  id              String              @id @default(cuid())
  worksiteId      String?
  userId          String?
  name            String
  description     String?
  type            WorkflowType
  enabled         Boolean             @default(true)
  triggerType     String
  triggerConfig   Json
  actions         Json
  batchingEnabled Boolean             @default(false)
  batchWindow     Int?
  rateLimitWindow Int?
  priority        Int                 @default(1)
  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lastRunAt       DateTime?
  worksite        Worksite?           @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  user            User?               @relation(fields: [userId], references: [id])
  executions      WorkflowExecution[]

  @@index([worksiteId])
  @@index([userId])
  @@index([type])
  @@index([enabled])
}

model WorkflowExecution {
  id              String    @id @default(cuid())
  workflowId      String
  triggeredBy     String
  triggerData     Json?
  status          String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  actionsExecuted Int       @default(0)
  actionsFailed   Int       @default(0)
  results         Json?
  error           String?
  createdAt       DateTime  @default(now())
  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
}

model EscalationChain {
  id          String       @id @default(cuid())
  worksiteId  String
  name        String
  description String?
  severity    String[]
  alertTypes  String[]
  steps       Json
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  worksite    Worksite     @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  escalations Escalation[]

  @@index([worksiteId])
  @@index([enabled])
}

model Escalation {
  id             String          @id @default(cuid())
  alertId        String
  chainId        String
  currentLevel   Int             @default(1)
  status         String
  acknowledgedAt DateTime?
  acknowledgedBy String?
  notifications  Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  alert          Alert           @relation(fields: [alertId], references: [id], onDelete: Cascade)
  chain          EscalationChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([chainId])
  @@index([status])
}

model NotificationLog {
  id          String    @id @default(cuid())
  worksiteId  String?
  alertId     String?
  workflowId  String?
  channel     String
  recipient   String
  subject     String?
  body        String
  metadata    Json?
  status      String
  sentAt      DateTime?
  deliveredAt DateTime?
  error       String?
  cost        Float?
  createdAt   DateTime  @default(now())

  @@index([worksiteId])
  @@index([alertId])
  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
}

model IncidentReport {
  id           String    @id @default(cuid())
  worksiteId   String
  alertId      String    @unique
  reportNumber String    @unique
  severity     String
  title        String
  summary      String
  details      Json
  snapshots    Json
  videoClips   Json?
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  auditHash    String?
  immutable    Boolean   @default(false)
  sentTo       Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  worksite     Worksite  @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  alert        Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([worksiteId])
  @@index([severity])
  @@index([createdAt])
}

model WorksiteMetrics {
  id               String   @id @default(cuid())
  worksiteId       String
  date             DateTime
  totalAlerts      Int      @default(0)
  alertsByType     Json
  alertsBySeverity Json
  alertsByHour     Json
  camerasOnline    Int      @default(0)
  camerasOffline   Int      @default(0)
  averageUptime    Float?
  complianceRate   Float?
  violationsByZone Json?
  topHotspots      Json?
  createdAt        DateTime @default(now())
  worksite         Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@unique([worksiteId, date])
  @@index([worksiteId])
  @@index([date])
}

model AlertBatch {
  id                String    @id @default(cuid())
  worksiteId        String
  batchStart        DateTime
  batchEnd          DateTime
  alertIds          String[]
  alertCount        Int
  topTypes          Json
  topZones          Json
  severityBreakdown Json
  notificationSent  Boolean   @default(false)
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  worksite          Worksite  @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@index([worksiteId])
  @@index([batchStart])
}

model WorkflowTemplate {
  id            String       @id @default(cuid())
  name          String
  description   String
  type          WorkflowType
  defaultConfig Json
  category      String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@index([category])
}

model ContactInquiry {
  id         String        @id @default(cuid())
  name       String
  email      String
  company    String?
  industry   String?
  message    String
  sourcePage String?
  status     InquiryStatus @default(UNREAD)
  isRead     Boolean       @default(false)
  repliedAt  DateTime?
  resolvedAt DateTime?
  notes      String?
  assignedTo String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([isRead])
  @@index([createdAt])
  @@map("ContactInquiry")
}

model FalsePositiveReport {
  id            String    @id @default(cuid())
  alertId       String?
  detectionId   String?
  worksiteId    String?
  cameraId      String?
  reportedBy    String?
  description   String?
  incidentType  String?
  videoUrl      String?
  imageUrl      String?
  timestamp     DateTime?
  reviewed      Boolean   @default(false)
  reviewedBy    String?
  reviewedAt    DateTime?
  trainingNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  worksite      Worksite? @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  camera        Camera?   @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([worksiteId])
  @@index([cameraId])
  @@index([reviewed])
  @@index([createdAt])
}

model TruePositiveReport {
  id            String    @id @default(cuid())
  alertId       String?
  detectionId   String?
  worksiteId    String?
  cameraId      String?
  reportedBy    String?
  description   String?
  incidentType  String?
  videoUrl      String?
  imageUrl      String?
  timestamp     DateTime?
  reviewed      Boolean   @default(false)
  reviewedBy    String?
  reviewedAt    DateTime?
  trainingNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  worksite      Worksite? @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  camera        Camera?   @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([worksiteId])
  @@index([cameraId])
  @@index([reviewed])
  @@index([createdAt])
}

