{
  "dashboard": {
    "title": "Alerts & Notifications",
    "tags": ["alerts", "notifications"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Alerts Sent (Rate)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(alerts_orchestrated_total[5m])",
            "legendFormat": "{{severity}} ({{success}})"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Alerts/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Alert Delivery Success Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(alerts_orchestrated_total{success=\"true\"}[5m]) / rate(alerts_orchestrated_total[5m])",
            "legendFormat": "Success Rate"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Success Rate", "max": 1},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Alert Delivery Failures",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(alerts_orchestrated_total{success=\"false\"}[5m])",
            "legendFormat": "{{tenant_id}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Failures/sec"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.1], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "last"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "10s",
          "handler": 1,
          "name": "High Alert Delivery Failure Rate",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 4,
        "title": "Rate Limited Alerts",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(alerts_rate_limited_total[5m])",
            "legendFormat": "{{reason}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Rate Limited/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Channel Delivery Errors",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(alert_channel_errors_total[5m])",
            "legendFormat": "{{channel}} - {{error_type}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Errors/sec"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.2], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "last"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "10s",
          "handler": 1,
          "name": "Channel Delivery Failure",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 6,
        "title": "Alert Retry Attempts",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "rate(alert_retry_attempts_total[5m])",
            "legendFormat": "{{channel}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Retries/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Acknowledgements",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(acknowledgements_created_total[5m])",
            "legendFormat": "{{method}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "ACKs/sec"},
          {"format": "short"}
        ]
      }
    ]
  }
}

