{
  "dashboard": {
    "title": "Detection Service",
    "tags": ["detection", "ml"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Frames Processed (Rate)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(frames_processed_total[5m])",
            "legendFormat": "{{camera_id}} ({{device}})"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Frames/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Frames Dropped (Rate)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(frames_dropped_total[5m])",
            "legendFormat": "{{camera_id}} - {{reason}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Drops/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Inference Latency (p95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(inference_latency_ms_bucket[5m]))",
            "legendFormat": "p95 ({{device}})"
          },
          {
            "expr": "histogram_quantile(0.50, rate(inference_latency_ms_bucket[5m]))",
            "legendFormat": "p50 ({{device}})"
          }
        ],
        "yaxes": [
          {"format": "ms", "label": "Latency (ms)"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "GPU Batch Size",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(gpu_batch_size_bucket[5m]))",
            "legendFormat": "p50 batch size"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Batch Size"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Redis Stream Lag",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "redis_stream_lag_entries",
            "legendFormat": "{{camera_id}} ({{device}})"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Lag (entries)"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [100], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "last"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "10s",
          "handler": 1,
          "name": "High GPU Lag",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 6,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "rate(detection_service_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Errors/sec"},
          {"format": "short"}
        ]
      }
    ]
  }
}

