{
  "dashboard": {
    "title": "Streaming Service",
    "tags": ["streaming"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Active Streams",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(streams_active_total)",
            "legendFormat": "Active Streams"
          }
        ]
      },
      {
        "id": 2,
        "title": "Streams by Protocol",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "sum by (protocol) (streams_active_total)",
            "legendFormat": "{{protocol}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Stream Availability",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "stream_availability",
            "legendFormat": "{{camera_id}} ({{protocol}})"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Availability (1=up, 0=down)", "max": 1, "min": 0},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Stream Restarts",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(stream_restarts_total[5m])",
            "legendFormat": "{{camera_id}} ({{protocol}})"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Restarts/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Stream Uptime",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(stream_uptime_seconds_bucket[5m]))",
            "legendFormat": "p95 uptime ({{camera_id}})"
          },
          {
            "expr": "histogram_quantile(0.50, rate(stream_uptime_seconds_bucket[5m]))",
            "legendFormat": "p50 uptime ({{camera_id}})"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Uptime (seconds)"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Unavailable Streams",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "stream_availability == 0",
            "format": "table",
            "instant": true
          }
        ]
      }
    ]
  }
}

