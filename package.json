{
  "name": "nexxau-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade multi-tenant PPE detection platform",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:packages": "npm run build --workspace=packages/*",
    "clean": "npm run clean --workspaces || true",
    "lint": "npm run lint --workspaces || true",
    "test": "npm run test --workspaces || true"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}