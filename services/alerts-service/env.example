# Alerts Service Configuration

# Service Configuration
PORT=8080
METRICS_PORT=8000

# Alert Configuration
ALERT_SUPPRESSION_WINDOW_SECONDS=60
REQUIRE_SNAPSHOTS=true
ALERT_RETRY_MAX_ATTEMPTS=3
ALERT_RETRY_BACKOFF_SECONDS=1.0

# Channel Configuration
ENABLE_WEBSOCKET=true
ENABLE_EMAIL=true
ENABLE_SMS=false

# Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# S3 Configuration (for signed URLs)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=3600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexxau
DB_USER=postgres
DB_PASSWORD=

# Logging
LOG_LEVEL=INFO

