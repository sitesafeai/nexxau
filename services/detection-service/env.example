# Service Configuration
PORT=8080
METRICS_PORT=8000

# YOLO Model Configuration
YOLO_MODEL_PATH=/models/yolov8n.pt
YOLO_DEVICE=cpu

# GPU Batching Configuration (GPU mode only)
GPU_MAX_BATCH_SIZE=4
GPU_MAX_BATCH_LATENCY_MS=50

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Logging
LOG_LEVEL=INFO
