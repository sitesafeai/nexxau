# Snapshot Service Configuration

# Service Configuration
PORT=8080
METRICS_PORT=8000

# Snapshot Capture Configuration
FRAMES_BASE_PATH=/tmp/frames
CAPTURE_CLIPS=true
CLIP_DURATION_SECONDS=5
CLIP_PRE_SECONDS=2
CLIP_POST_SECONDS=3

# S3 Storage Configuration
S3_ENDPOINT_URL=  # Leave empty for AWS S3, set for MinIO (e.g., http://localhost:9000)
S3_BUCKET=violation-snapshots
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Signed URL Configuration
SIGNED_URL_TTL_SECONDS=3600  # 1 hour default

# Retention Configuration
RETENTION_DAYS=30
ENABLE_RETENTION_WORKER=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexxau
DB_USER=postgres
DB_PASSWORD=

# Logging
LOG_LEVEL=INFO

