# Streaming Service Configuration

# Service Configuration
PORT=8080

# Protocol Selection
SMALL_SITE_THRESHOLD=10

# Protocol Enable/Disable
WEBRTC_ENABLED=true
LL_HLS_ENABLED=true

# Ports
RTMP_PORT=1935
HLS_PORT=8080
WEBRTC_PORT=8081

# HLS Settings
HLS_SEGMENT_DURATION=2.0
HLS_SEGMENT_COUNT=3

# Fallback
ENABLE_FALLBACK=true

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexxau
DB_USER=postgres
DB_PASSWORD=

# Logging
LOG_LEVEL=INFO

