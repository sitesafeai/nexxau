# Violation Engine Service Configuration

# Service Configuration
PORT=8080
METRICS_PORT=8000

# Violation Engine Parameters
VIOLATION_WINDOW_SECONDS=10          # Sliding window size (seconds)
VIOLATION_DETECTION_THRESHOLD=3      # Minimum detections to trigger ACTIVE
VIOLATION_ESCALATION_SECONDS=120     # Seconds before escalation
VIOLATION_RESOLUTION_SECONDS=30      # Seconds without detection before resolution
VIOLATION_SUPPRESSION_SECONDS=60     # Alert suppression cooldown (seconds)

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Logging
LOG_LEVEL=INFO

