{
  "buildCommand": "npx prisma@6.19.3 generate && next build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.nexxau.com"
        }
      ],
      "destination": "https://nexxau.com/:path*",
      "permanent": true
    }
  ]
}